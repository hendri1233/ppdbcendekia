# Database. Kosongkan untuk memakai root tanpa kata sandi di localhost (Laragon).
DB_HOST=localhost
DB_NAME=ppdb_cendekia
DB_USER=root
DB_PASS=

# Alamat situs dan folder privat di luar folder publik.
PPDB_BASE_URL=https://cendekiatakengon.or.id
PPDB_PAYMENT_STORAGE=/home/u000000000/private/ppdb-payment-proofs
GOOGLE_APPLICATION_CREDENTIALS=/home/u000000000/private/ppdb-sheets-service-account.json
PPDB_GOOGLE_SPREADSHEET_ID=
PPDB_GOOGLE_SHEET_TAB=

# Salinan dokumen peserta di Google Drive yayasan (OAuth Client ID tipe "Web application").
# Authorized redirect URI: https://cendekiatakengon.or.id/google-drive-auth.php
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Folder Drive tujuan PDF cetak peserta (per unit). Kosong = folder panitia bawaan.
GOOGLE_DRIVE_CETAK_FOLDER_ID=

WABLAS_BASE_URL=https://smg.wablas.com
WABLAS_TOKEN=your-wablas-token
WABLAS_SECRET=your-wablas-secret

# Asisten AI tanya jawab (Claude API). Kosongkan untuk menyembunyikan tombol asisten.
ANTHROPIC_API_KEY=

# Peta pengakses tautan di dashboard. Unduh GeoLite2-City.mmdb (akun gratis maxmind.com),
# simpan di luar folder publik, lalu isi lokasinya. Kosongkan untuk memakai storage/geoip/GeoLite2-City.mmdb.
GEOIP_DB_PATH=
