WABLAS_BASE_URL=https://smg.wablas.com
WABLAS_TOKEN=your-wablas-token
WABLAS_SECRET=your-wablas-secret

# Asisten AI tanya jawab (Claude API). Kosongkan untuk menyembunyikan tombol asisten.
ANTHROPIC_API_KEY=

# Peta pengakses tautan di dashboard. Unduh GeoLite2-City.mmdb (akun gratis maxmind.com),
# simpan di luar folder publik, lalu isi lokasinya. Kosongkan untuk memakai storage/geoip/GeoLite2-City.mmdb.
GEOIP_DB_PATH=
