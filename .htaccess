# Konfigurasi (kredensial, path Google service account, dll.) diatur di .env, bukan di sini.

Options -Indexes

# Folder kode dan data internal tidak disajikan langsung.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # URL publik lama tetap diterima, lalu dialihkan ke bentuk kanonis tanpa .php.
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)?index\.php(?:[?\s]) [NC]
    RewriteRule ^index\.php$ ./ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)?ppdb\.php(?:[?\s]) [NC]
    RewriteRule ^ppdb\.php$ spmb [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)?direktori-unit\.php(?:[?\s]) [NC]
    RewriteRule ^direktori-unit\.php$ unit [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)?(tentang|kontak|kurikulum|cerita|program|galeri)\.php(?:[?\s]) [NC]
    RewriteRule ^(tentang|kontak|kurikulum|cerita|program|galeri)\.php$ $1 [R=301,L,NE]

    # Rute publik bersih diteruskan ke file PHP yang sudah ada.
    RewriteRule ^berita/([a-z0-9-]+)/?$ berita.php?baca=$1 [QSA,NC,END]
    RewriteRule ^unit/([a-z0-9-]+)/?$ unit.php?slug=$1 [QSA,NC,END]
    RewriteRule ^(tentang|kontak|kurikulum|cerita|program|galeri)/?$ $1.php [NC,END]
    RewriteRule ^spmb/?$ ppdb.php [NC,END]
    RewriteRule ^berita/?$ berita.php [NC,END]
    RewriteRule ^unit/?$ direktori-unit.php [NC,END]

    RewriteRule ^(vendor|migrations|storage|templates|partials|deploy)(/|$) - [F,L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)(\.(sql|md|json|lock|xlsx|bak|log|mmdb|tar\.gz)|^env\.example)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>
