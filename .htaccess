# Konfigurasi (kredensial, path Google service account, dll.) diatur di .env, bukan di sini.

Options -Indexes

# Folder kode dan data internal tidak disajikan langsung.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sitemap bersifat dinamis agar berita terbit dan profil unit terbaru tercantum.
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)?sitemap\.php(?:[?\s]) [NC]
    RewriteRule ^sitemap\.php$ sitemap.xml [R=301,L,NE]
    RewriteRule ^sitemap\.xml$ sitemap.php [END]

    # URL publik lama tetap diterima, lalu dialihkan ke bentuk kanonis tanpa .php.
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)?index\.php(?:[?\s]) [NC]
    RewriteRule ^index\.php$ ./ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)?ppdb\.php(?:[?\s]) [NC]
    RewriteRule ^ppdb\.php$ spmb [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)?direktori-unit\.php(?:[?\s]) [NC]
    RewriteRule ^direktori-unit\.php$ unit [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)?(tentang|kontak|kurikulum|cerita|program|sosial|usaha|galeri|kebijakan-privasi)\.php(?:[?\s]) [NC]
    RewriteRule ^(tentang|kontak|kurikulum|cerita|program|sosial|usaha|galeri|kebijakan-privasi)\.php$ $1 [R=301,L,NE]

    # Halaman pendaftaran: alamat lama dialihkan (hanya GET, agar formulir yang sedang terbuka tetap terkirim).
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/+([^?\s]+/)?(daftar|berhasil|formulir|status-pendaftaran|lanjutkan-pendaftaran|verifikasi-surat|cetak-bukti|upload-bukti-pembayaran|ppdb-materi-file|api-tanya)\.php(?:[?\s]) [NC]
    RewriteRule ^(daftar|berhasil|formulir|status-pendaftaran|lanjutkan-pendaftaran|verifikasi-surat|cetak-bukti|upload-bukti-pembayaran|ppdb-materi-file|api-tanya)\.php$ /%2$1 [R=301,L,NE]
    RewriteCond %{THE_REQUEST} ^\S+\s/+([^?\s]+/)?(daftar|berhasil|formulir|status-pendaftaran|lanjutkan-pendaftaran|verifikasi-surat|cetak-bukti|upload-bukti-pembayaran|ppdb-materi-file|api-tanya)/(?:[?\s]) [NC]
    RewriteRule ^(daftar|berhasil|formulir|status-pendaftaran|lanjutkan-pendaftaran|verifikasi-surat|cetak-bukti|upload-bukti-pembayaran|ppdb-materi-file|api-tanya)/$ /%1$1 [R=301,L,NE]

    # Rute publik bersih diteruskan ke file PHP yang sudah ada.
    RewriteRule ^lanjut/(P[0-9]{9})-([a-f0-9]{12})/?$ lanjut.php?kode=$1&sig=$2 [END]
    RewriteRule ^berita/([a-z0-9-]+)/?$ berita.php?baca=$1 [QSA,NC,END]
    RewriteRule ^unit/([a-z0-9-]+)/?$ unit.php?slug=$1 [QSA,NC,END]
    RewriteRule ^(tentang|kontak|kurikulum|cerita|program|sosial|usaha|galeri|kebijakan-privasi)/?$ $1.php [NC,END]
    RewriteRule ^spmb/?$ ppdb.php [NC,END]
    RewriteRule ^(daftar|berhasil|formulir|status-pendaftaran|lanjutkan-pendaftaran|verifikasi-surat|cetak-bukti|upload-bukti-pembayaran|ppdb-materi-file|api-tanya)$ $1.php [NC,END]
    RewriteRule ^berita/?$ berita.php [NC,END]
    RewriteRule ^unit/?$ direktori-unit.php [NC,END]

    RewriteRule ^(vendor|migrations|storage|templates|partials|deploy)(/|$) - [F,L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)(\.(sql|md|json|lock|xlsx|bak|log|mmdb|tar\.gz)|^env\.example)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Kompresi teks; gambar sudah memakai format terkompresi.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    <IfModule !mod_brotli.c>
        AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
    </IfModule>
</IfModule>

# Cache browser untuk aset statis; file CSS/JS publik menggunakan versi filemtime.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(?:jpe?g|png|gif|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(?:woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>
