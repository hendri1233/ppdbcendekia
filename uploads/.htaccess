# Folder unggahan publik: hanya gambar yang disajikan, tidak ada skrip.
Options -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|cgi|pl|py|sh|asp|aspx|jsp|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    <FilesMatch "(?i)\.(webp|jpe?g|png)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>
